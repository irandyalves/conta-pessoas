rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita para presenças e configurações em tempo real
    match /presencas/{document=**} {
      allow read, write: if true;
    }
    match /configuracoes/{document=**} {
      allow read, write: if true;
    }
    // Fallback permissivo para qualquer outra coleção de apoio
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
